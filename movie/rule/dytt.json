{
  "siteName": "电影天堂",
  "baseUrl": "https://dyttzy4.tv", 
  "categoryRule": {
    "selectorType": "css",
    "itemSelector": "nav li a",
    "fields": {
      "typeName": {
        "selectors": [":root"],
        "attr": "text"
      },
      "typeUrl": {
        "selectors": [":root"],
        "attr": "href"
      }
    },
    "includeName": ["电影", "电视剧", "动漫", "综艺", "纪录片", "短剧"],
    "excludeName": ["首页", "排行榜", "留言", "关于", "公告", "资讯", "新闻"],
    "urlRegex": ".*/vod/type/id/\\d+\\.html"
  },
  "listRule": {
    "url": "/index.php/vod/type/id/{id}.html",
    "selectorType": "css",
    "itemSelector": "main tbody > tr",
    "fields": {
        "vodName": {
            "selectors": ["th a > div > div:nth-child(2) > div:nth-child(1)"]
        },
        "vodSubName": {
            "selectors": ["th a > div > div:nth-child(2) > div:nth-child(2)"]
        },
        "vodPic": {
            "selectors": ["img"],
            "attr": "src"
        },
        "vodRemarks": {
            "selectors": ["td:nth-child(2) span"]
        },
        "vodYear": {
            "selectors": ["td:nth-child(3)"]
        },
        "vodArea": {
            "selectors": ["td:nth-child(4)"]
        },
        "typeName": {
            "selectors": ["td:nth-child(5)"]
        },
        "vodScore": {
            "selectors": ["td:nth-child(6) p"],
            "default": "0.0"
        },
        "vodUrl": {
            "selectors": ["th a"],
            "attr": "href"
        },
        "vodUpdateTime": {
            "selectors": ["td:nth-child(7)"]
        }
    }
},
  "searchRule": {
    "url": "/index.php/vod/search/page/{page}/wd/{keyword}.html",
    "method": "get",
    "body": {},
    "resultRule": null
  },
  "detailRule":{
    "url": "/index.php/vod/detail/id/{id}.html",
    "selectorType": "css",
    "rootSelector": "main",
    "fields": {
        "vodName": {
            "selectors": ["h1"]
        },
        "vodSubName": {
            "selectors": ["h2"]
        },
        "vodPic": {
            "selectors": ["img[src]:first-child"],
            "attr": "src"
        },
        "vodScore": {
            "selectors": ["tbody tr:contains(豆瓣) td:nth-child(2)"]
        },
        "vodRemarks": {
            "selectors": ["tbody tr:contains(状态) td:nth-child(2)"]
        },
        "vodType": {
            "selectors": ["tbody tr:contains(类型) td:nth-child(2)"]
        },
        "vodDirector": {
            "selectors": ["tbody tr:contains(导演) td:nth-child(2)"]
        },
        "vodActor": {
            "selectors": ["tbody tr:contains(演员) td:nth-child(2)"]
        },
        "vodYear": {
            "selectors": ["tbody tr:contains(年代) td:nth-child(2)"]
        },
        "vodArea": {
            "selectors": ["tbody tr:contains(地区) td:nth-child(2)"]
        },
        "vodLang": {
            "selectors": ["tbody tr:contains(语言) td:nth-child(2)"]
        },
        "vodUpdateTime": {
            "selectors": ["tbody tr:contains(更新时间) td:nth-child(2)"]
        },
        "vodContent": {
            "selectors": [".max-h-\\[290px\\] p"]
        }
    },
    "playListRule": {
        "itemSelector": "ul.dyttm3u8 li a",
        "attr": "text",
        "splitSep": "$"
    }
},
  "preProcess": {
    "picAutoFullUrl": true,
    "trimText": true
  }
}
